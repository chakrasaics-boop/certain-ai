# Copy to .env and fill in what you have. Anything left blank runs SIMULATED.
# Crusoe Managed Inference (console.crusoecloud.com -> Intelligence Foundry -> Get API Key)
CRUSOE_API_KEY=
# PLANNER_MODEL=moonshotai/Kimi-K2.6
# CHECKER_MODEL=nvidia/Nemotron-3-Nano-Omni-Reasoning-30B-A3B

# Neo4j AuraDB (console.neo4j.io); then run: npm run seed:neo4j
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Band (app.band.ai): one room, three agents
BAND_ROOM_ID=
BAND_SCOUT_ID=
BAND_SCOUT_API_KEY=
BAND_SAFETY_CRITIC_ID=
BAND_SAFETY_CRITIC_API_KEY=
BAND_EXECUTOR_ID=
BAND_EXECUTOR_API_KEY=

# DuploCloud sandbox tenant (needs duploctl installed: pip install duplocloud-client)
DUPLO_HOST=
DUPLO_TOKEN=
DUPLO_TENANT=
